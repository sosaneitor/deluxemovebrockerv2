---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import { CONTENT } from '../i18n/content';

// One bilingual 404 (Vercel serves 404.html for every unknown path).
const en = CONTENT.en.notFound;
const es = CONTENT.es.notFound;
---

<BaseLayout lang="en" title={`${en.title} | Deluxe Move Broker`} description={en.sub} noindex>
  <Header lang="en" />
  <main id="main" class="nf">
    <div class="shell nf-inner">
      <p class="eyebrow">404</p>
      <h1>{en.title}</h1>
      <p class="nf-sub">{en.sub}</p>
      <p class="nf-sub" lang="es">{es.title}. {es.sub}</p>
      <div class="nf-cta">
        <a href="/" class="btn btn-amber">{en.cta}</a>
        <a href="/es/" class="btn btn-ghost" lang="es">{es.cta}</a>
      </div>
    </div>
  </main>
</BaseLayout>

<style>
  .nf {
    min-height: 100svh;
    display: grid;
    place-items: center;
    padding-block: 8rem 4rem;
  }
  .nf-inner {
    text-align: center;
    max-width: 40rem;
  }
  .nf h1 {
    font-size: var(--text-3xl);
    margin-top: 0.75rem;
  }
  .nf-sub {
    color: var(--fg-dim);
    margin-top: 1rem;
  }
  .nf-cta {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 2rem;
  }
</style>
