---
import { CONTENT, type Lang } from '../i18n/content';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = CONTENT[lang].how;
---

<section class="section how" id="how">
  <div class="shell">
    <header class="sec-head" data-reveal>
      <p class="eyebrow">{t.eyebrow}</p>
      <h2>{t.title}</h2>
    </header>

    <ol class="how-grid">
      {t.steps.map((s) => (
        <li class="how-step" data-reveal>
          <span class="how-n">{s.n}</span>
          <h3>{s.name}</h3>
          <p>{s.desc}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .how {
    background: var(--surface);
    border-block: 1px solid var(--line);
  }
  .how-grid {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 1.5rem;
    grid-template-columns: 1fr;
    counter-reset: step;
  }
  .how-step {
    position: relative;
    padding: 1.75rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background: var(--bg);
  }
  .how-n {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: 700;
    color: transparent;
    -webkit-text-stroke: 1px color-mix(in srgb, var(--color-amber) 70%, transparent);
  }
  .how-step h3 {
    font-size: var(--text-lg);
    margin-top: 0.75rem;
  }
  .how-step p {
    color: var(--fg-dim);
    margin-top: 0.5rem;
  }
  @media (min-width: 780px) {
    .how-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
