---
import { CONTENT, type Lang } from '../i18n/content';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = CONTENT[lang].how;
---

<section class="section how" id="how">
  <div class="shell">
    <header class="sec-head" data-reveal>
      <p class="eyebrow">{t.eyebrow}</p>
      <h2>{t.title}</h2>
    </header>

    <!-- Signature moment: a car carrier drives this road as the visitor scrolls the steps. -->
    <div class="how-road" data-road aria-hidden="true">
      <div class="how-road-line"></div>
      <div class="how-road-fill" data-road-fill></div>
      <div class="how-truck" data-truck>
        <svg viewBox="0 0 64 28" width="64" height="28" fill="none">
          <rect x="2" y="12" width="36" height="3" rx="1.5" fill="var(--color-amber)" />
          <rect x="4" y="4" width="34" height="2.5" rx="1.25" fill="var(--color-amber)" />
          <rect x="6" y="0" width="12" height="4" rx="2" fill="var(--fg)" opacity="0.85" />
          <rect x="22" y="0" width="12" height="4" rx="2" fill="var(--fg)" opacity="0.85" />
          <rect x="6" y="8" width="12" height="4" rx="2" fill="var(--fg)" opacity="0.85" />
          <rect x="22" y="8" width="12" height="4" rx="2" fill="var(--fg)" opacity="0.85" />
          <path d="M40 6h12l8 8v7H40V6Z" fill="var(--color-amber)" />
          <path d="M45 9h6l5 5h-11V9Z" fill="#0b0d10" opacity="0.7" />
          <rect x="2" y="15" width="58" height="6" rx="2" fill="#1d2129" />
          <circle cx="10" cy="23" r="4" fill="#0b0d10" stroke="var(--fg)" stroke-width="1.5" />
          <circle cx="22" cy="23" r="4" fill="#0b0d10" stroke="var(--fg)" stroke-width="1.5" />
          <circle cx="52" cy="23" r="4" fill="#0b0d10" stroke="var(--fg)" stroke-width="1.5" />
          <rect x="59" y="15" width="3" height="3" rx="1" fill="#fff4dc" />
        </svg>
      </div>
    </div>

    <ol class="how-grid">
      {t.steps.map((s) => (
        <li class="how-step" data-reveal data-spotlight>
          <span class="how-n">{s.n}</span>
          <h3>{s.name}</h3>
          <p>{s.desc}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .how {
    background: var(--surface);
    border-block: 1px solid var(--line);
  }
  .how-road {
    position: relative;
    height: 40px;
    margin: 0 32px 1.75rem;
  }
  .how-road-line,
  .how-road-fill {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 4px;
    height: 2px;
  }
  .how-road-line {
    background: repeating-linear-gradient(90deg, var(--line) 0 14px, transparent 14px 26px);
  }
  .how-road-fill {
    background: linear-gradient(90deg, var(--color-amber-deep), var(--color-amber));
    transform-origin: left;
    transform: scaleX(0);
    box-shadow: 0 0 12px color-mix(in srgb, var(--color-amber) 60%, transparent);
  }
  .how-truck {
    position: absolute;
    bottom: 2px;
    left: 0;
    transform: translateX(-50%);
    filter: drop-shadow(0 4px 10px rgba(0, 0, 0, 0.5));
  }
  .how-grid {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 1.5rem;
    grid-template-columns: 1fr;
  }
  .how-step {
    position: relative;
    padding: 1.75rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background: var(--bg);
    transition: border-color 0.5s var(--ease-signature), box-shadow 0.5s var(--ease-signature);
  }
  /* Lit as the truck reaches the step (static fallback: always lit for reduced motion). */
  .how-step:global(.is-lit) {
    border-color: color-mix(in srgb, var(--color-amber) 55%, var(--line));
    box-shadow: 0 18px 40px -24px color-mix(in srgb, var(--color-amber) 55%, transparent);
  }
  .how-n {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: 700;
    color: color-mix(in srgb, var(--color-amber) 40%, var(--fg-dim));
    transition: color 0.5s var(--ease-signature), text-shadow 0.5s;
  }
  .how-step:global(.is-lit) .how-n {
    color: var(--color-amber);
    text-shadow: 0 0 24px color-mix(in srgb, var(--color-amber) 55%, transparent);
  }
  .how-step h3 {
    font-size: var(--text-lg);
    margin-top: 0.75rem;
  }
  .how-step p {
    color: var(--fg-dim);
    margin-top: 0.5rem;
  }
  @media (min-width: 780px) {
    .how-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
