---
import Logo from './Logo.astro';
import { CONTENT, CONTACT, whatsappHref, privacyHref, type Lang } from '../i18n/content';

interface Props { lang: Lang; currentYear: number }
const { lang, currentYear } = Astro.props;
const t = CONTENT[lang];
const nav = t.nav;
const home = lang === 'es' ? '/es/' : '/';
const links = [
  { href: `${home}#services`, label: nav.services },
  { href: `${home}#how`, label: nav.how },
  { href: `${home}#pricing`, label: nav.pricing },
  { href: `${home}#reviews`, label: nav.reviews },
  { href: `${home}#faq`, label: nav.faq },
  { href: `${home}#quote`, label: nav.quote },
];
---

<footer class="site-footer">
  <div class="shell footer-inner">
    <div class="footer-brand">
      <Logo height={56} />
      <p>{t.footer.tagline}</p>
    </div>

    <div class="footer-col">
      <h2 class="footer-h">{t.footer.contact}</h2>
      <address class="footer-address">
        <a href={CONTACT.phoneHref}>{CONTACT.phone}</a>
        <a href={whatsappHref(lang)} target="_blank" rel="noopener">WhatsApp</a>
        <a href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a>
        <span>{CONTACT.location}</span>
        <span><span class="footer-label">{t.footer.hoursLabel}:</span> {t.hours}</span>
      </address>
    </div>

    <nav class="footer-col footer-nav" aria-label={t.footer.nav}>
      {links.map((l) => <a href={l.href}>{l.label}</a>)}
    </nav>
  </div>

  <div class="shell footer-bottom">
    <p>© {currentYear} Deluxe Move Broker LLC. {t.footer.rights}</p>
    <a href={privacyHref(lang)}>{t.footer.privacy}</a>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--line);
    padding-top: clamp(3rem, 7vw, 5rem);
    /* Room for the mobile sticky CTA bar so it never covers the last line. */
    padding-bottom: calc(6rem + env(safe-area-inset-bottom));
    background: var(--bg);
  }
  .footer-inner {
    display: grid;
    gap: 2.5rem;
    padding-bottom: 2.5rem;
    border-bottom: 1px solid var(--line);
  }
  .footer-brand p {
    color: var(--fg-dim);
    margin-top: 1rem;
    max-width: 32ch;
  }
  .footer-h {
    font-size: var(--text-sm);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-amber);
    margin-bottom: 1rem;
  }
  .footer-address {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    font-style: normal;
    color: var(--fg-dim);
  }
  .footer-address a {
    padding-block: 0.15rem;
  }
  .footer-address a:hover {
    color: var(--color-amber);
  }
  .footer-label {
    color: var(--fg);
  }
  .footer-nav {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.25rem 2rem;
    align-content: start;
  }
  .footer-nav a {
    color: var(--fg-dim);
    font-size: var(--text-sm);
    padding-block: 0.45rem;
  }
  .footer-nav a:hover {
    color: var(--fg);
  }
  .footer-bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    padding-top: 1.5rem;
    font-size: var(--text-xs);
    color: var(--fg-dim);
  }
  .footer-bottom a:hover {
    color: var(--fg);
  }
  @media (min-width: 720px) {
    .footer-inner {
      grid-template-columns: 1.2fr 1fr 1fr;
    }
  }
  @media (min-width: 900px) {
    .site-footer {
      padding-bottom: calc(2rem + env(safe-area-inset-bottom));
    }
  }
</style>
