---
import Logo from './Logo.astro';
import { CONTENT, CONTACT, type Lang } from '../i18n/content';

interface Props {
  lang: Lang;
  /** URL of this same page in the other language (defaults to the other home). */
  altHref?: string;
}
const { lang, altHref } = Astro.props;
const t = CONTENT[lang].nav;
const home = lang === 'es' ? '/es/' : '/';
const otherLangHref = altHref ?? (lang === 'es' ? '/' : '/es/');
const otherLangLabel = lang === 'es' ? 'EN' : 'ES';

const links = [
  { href: `${home}#services`, label: t.services },
  { href: `${home}#how`, label: t.how },
  { href: `${home}#why`, label: t.why },
  { href: `${home}#pricing`, label: t.pricing },
  { href: `${home}#reviews`, label: t.reviews },
  { href: `${home}#faq`, label: t.faq },
];
---

<div class="scroll-progress" data-progress aria-hidden="true"></div>
<header class="site-header" id="site-header">
  <div class="shell header-inner">
    <a href={home} class="header-logo" aria-label="Deluxe Move Broker — home">
      <Logo />
    </a>

    <nav class="header-nav" aria-label="Primary">
      {links.map((l) => <a href={l.href}>{l.label}</a>)}
    </nav>

    <div class="header-actions">
      <a href={otherLangHref} class="lang-switch" aria-label={`Switch to ${otherLangLabel}`}>{otherLangLabel}</a>
      <a href={CONTACT.phoneHref} class="header-call" aria-label={`${t.call} ${CONTACT.phone}`}>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" />
        </svg>
        <span class="header-call-num">{CONTACT.phone}</span>
      </a>
      <a href={`${home}#quote`} class="btn btn-amber header-cta">{t.quote}</a>
      <button type="button" class="menu-btn" id="menu-btn" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>

  <div class="mobile-menu" id="mobile-menu" hidden>
    <nav class="shell" aria-label="Mobile">
      {links.map((l) => <a href={l.href} data-close>{l.label}</a>)}
      <a href={`${home}#quote`} class="btn btn-amber btn-full" data-close>{t.quote}</a>
      <div class="mobile-contact">
        <a href={CONTACT.phoneHref}>{CONTACT.phone}</a>
        <a href={otherLangHref}>{otherLangLabel === 'ES' ? 'Español' : 'English'}</a>
      </div>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 50;
    transition: background-color 0.3s, border-color 0.3s, backdrop-filter 0.3s, transform 0.45s var(--ease-signature);
    border-bottom: 1px solid transparent;
  }
  .site-header.is-hidden {
    transform: translateY(-100%);
  }
  .site-header.scrolled {
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    backdrop-filter: blur(12px);
    border-bottom-color: var(--line);
  }
  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 68px;
    padding-top: env(safe-area-inset-top);
  }
  .header-logo :global(.logo) {
    height: 32px;
    width: auto;
  }
  @media (min-width: 768px) {
    .header-logo :global(.logo) {
      height: 40px;
    }
  }
  .header-nav {
    display: none;
    gap: 1.5rem;
    font-size: var(--text-sm);
    font-weight: 500;
  }
  .header-nav a {
    color: var(--fg-dim);
    transition: color 0.2s;
  }
  .header-nav a:hover {
    color: var(--fg);
  }
  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .lang-switch {
    display: grid;
    place-items: center;
    min-width: 40px;
    height: 40px;
    border-radius: var(--radius-full);
    border: 1px solid var(--line);
    font-family: var(--font-display);
    font-size: 0.8rem;
    font-weight: 600;
  }
  .lang-switch:hover {
    border-color: var(--color-amber);
    color: var(--color-amber);
  }
  .header-call {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-width: 40px;
    height: 40px;
    padding-inline: 0.65rem;
    border-radius: var(--radius-full);
    border: 1px solid var(--line);
    font-family: var(--font-display);
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--color-amber);
  }
  .header-call:hover {
    border-color: var(--color-amber);
  }
  .header-call-num {
    display: none;
  }
  .header-cta {
    display: none;
    min-height: 40px;
    padding: 0.55rem 1.1rem;
    font-size: 0.9rem;
  }
  .menu-btn {
    display: grid;
    gap: 4px;
    width: 40px;
    height: 40px;
    place-content: center;
    background: transparent;
    border: 0;
    cursor: pointer;
    padding: 0;
  }
  .menu-btn span {
    display: block;
    width: 20px;
    height: 2px;
    background: var(--fg);
    transition: transform 0.3s var(--ease-signature), opacity 0.2s;
  }
  .menu-btn[aria-expanded='true'] span:nth-child(1) {
    transform: translateY(6px) rotate(45deg);
  }
  .menu-btn[aria-expanded='true'] span:nth-child(2) {
    opacity: 0;
  }
  .menu-btn[aria-expanded='true'] span:nth-child(3) {
    transform: translateY(-6px) rotate(-45deg);
  }
  .mobile-menu {
    background: var(--bg);
    border-bottom: 1px solid var(--line);
    padding-block: 1.5rem;
  }
  .mobile-menu nav {
    display: grid;
    gap: 1rem;
  }
  .mobile-menu nav a {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    padding-block: 0.35rem;
  }
  .mobile-contact {
    display: flex;
    justify-content: space-between;
    padding-top: 1rem;
    margin-top: 0.5rem;
    border-top: 1px solid var(--line);
    color: var(--fg-dim);
    font-size: var(--text-sm);
  }
  .header-nav a {
    white-space: nowrap;
  }
  @media (min-width: 900px) {
    .header-cta {
      display: inline-flex;
    }
  }
  /* Full nav only where all six links fit on one line (ES labels are the longest). */
  @media (min-width: 1100px) {
    .header-nav {
      display: flex;
    }
    .menu-btn {
      display: none;
    }
  }
  @media (min-width: 1280px) {
    .header-call-num {
      display: inline;
    }
  }
</style>

<script>
  // Header scroll state
  const header = document.getElementById('site-header');
  // Solid after a little scroll; slides away while scrolling down, returns on scroll up.
  let lastY = window.scrollY;
  const onScroll = () => {
    const y = window.scrollY;
    header?.classList.toggle('scrolled', y > 24);
    const menuOpen = !document.getElementById('mobile-menu')?.hidden;
    header?.classList.toggle('is-hidden', y > lastY && y > 400 && !menuOpen);
    lastY = y;
  };
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  // Mobile menu
  const menuBtn = document.getElementById('menu-btn');
  const menu = document.getElementById('mobile-menu');
  const setMenu = (open: boolean) => {
    if (!menu || !menuBtn) return;
    menu.hidden = !open;
    menuBtn.setAttribute('aria-expanded', String(open));
    menuBtn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    document.body.style.overflow = open ? 'hidden' : '';
  };
  menuBtn?.addEventListener('click', () => setMenu(menu?.hidden ?? true));
  menu?.querySelectorAll('[data-close]').forEach((el) =>
    el.addEventListener('click', () => setMenu(false))
  );
</script>
