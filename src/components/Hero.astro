---
import { Image } from 'astro:assets';
import { CONTENT, whatsappHref, type Lang } from '../i18n/content';
import heroImg from '../assets/hero-car-carrier-highway.png';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = CONTENT[lang].hero;
const heroAlt =
  lang === 'es'
    ? 'Camión portaautos cargado de vehículos en la autopista al anochecer'
    : 'Car carrier truck loaded with vehicles on the highway at dusk';
---

<section class="hero" id="top">
  <div class="hero-canvas-wrap">
    <div class="hero-poster" aria-hidden="true"></div>
    <Image
      src={heroImg}
      alt={heroAlt}
      class="hero-photo"
      widths={[640, 1024, 1600, 1920]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      format="webp"
    />
    <div class="hero-veil" aria-hidden="true"></div>
    <canvas class="hero-canvas" data-highway aria-hidden="true"></canvas>
  </div>

  <div class="shell hero-inner">
    <p class="eyebrow">{t.eyebrow}</p>

    <h1 class="hero-title" data-split aria-label={t.title.join(' ')}>
      {t.title.map((w, i) => (
        <span class:list={['hero-word', { 'hero-accent': i === t.title.length - 1 }]} data-word aria-hidden="true">{w}</span>
      ))}
    </h1>

    <p class="hero-sub">{t.sub}</p>

    <div class="hero-cta">
      <a href="#quote" class="btn btn-amber">{t.cta}</a>
      <a href={whatsappHref(lang)} class="btn btn-ghost" target="_blank" rel="noopener">
        {t.ctaSecondary}
      </a>
    </div>

    <dl class="hero-stats">
      {t.stat.map((s) => (
        <div class="hero-stat">
          <dt data-count>{s.value}</dt>
          <dd>{s.label}</dd>
        </div>
      ))}
    </dl>
  </div>

  <a href="#services" class="hero-scroll" aria-label="Scroll">
    <span></span>
  </a>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: center;
    overflow: hidden;
    padding-top: clamp(6rem, 14vh, 9rem);
    padding-bottom: 4rem;
  }
  .hero-canvas-wrap {
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  .hero-poster,
  .hero-photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  /* Coded gradient sits behind the photo as ultimate fallback (zero CLS). */
  .hero-poster {
    background:
      radial-gradient(120% 90% at 80% 10%, color-mix(in srgb, var(--color-amber) 22%, transparent), transparent 55%),
      radial-gradient(90% 80% at 15% 90%, color-mix(in srgb, #2a3550 40%, transparent), transparent 60%),
      var(--bg);
  }
  .hero-photo {
    object-fit: cover;
    object-position: 70% center;
  }
  /* Veil. Desktop: darken the left (where copy sits) and fade into the page at the bottom. */
  .hero-veil {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(105deg, var(--bg) 8%, color-mix(in srgb, var(--bg) 55%, transparent) 42%, transparent 68%),
      linear-gradient(to bottom, transparent 45%, var(--bg) 97%);
    pointer-events: none;
  }

  /* Phones: a 16:9 photo behind a tall column of text only shows a sliver of the cab and
     the copy covers the road. Instead the photo becomes a panoramic band placed right
     under the CTAs (inside the first screen), where the whole truck, its lights and the
     road effects are visible; the stats sit on the band's faded lower edge. */
  @media (max-width: 767px) {
    .hero {
      min-height: auto;
      flex-direction: column;
      align-items: stretch;
      padding-top: 6.25rem;
      padding-bottom: 2.5rem;
      background: radial-gradient(120% 50% at 85% 0%, color-mix(in srgb, var(--color-amber) 14%, transparent), transparent 60%);
    }
    /* Let the copy blocks and the photo band share one flex column so they can be ordered. */
    .hero-inner {
      display: contents;
    }
    .hero-inner > * {
      position: relative;
      z-index: 1;
      margin-inline: clamp(1.15rem, 4vw, 3rem);
    }
    .hero-canvas-wrap {
      position: relative;
      inset: auto;
      order: 5;
      height: 86vw;
      margin-top: 1.25rem;
      margin-bottom: -4.5rem;
      overflow: hidden;
    }
    /* .hero prefix: these must beat the base .hero-stats rules defined further down. */
    .hero .hero-stats {
      order: 6;
      flex-wrap: nowrap;
      justify-content: space-between;
      gap: 1rem;
      margin-top: 0;
      padding-top: 1.25rem;
    }
    .hero-photo {
      object-position: 80% center;
    }
    .hero-poster {
      display: none;
    }
    /* Above the light layer here, so streaks fade out under the stats like the photo does. */
    .hero-veil {
      z-index: 1;
      background: linear-gradient(
        to bottom,
        var(--bg) 0%,
        color-mix(in srgb, var(--bg) 40%, transparent) 18%,
        transparent 38%,
        transparent 62%,
        color-mix(in srgb, var(--bg) 70%, transparent) 82%,
        var(--bg) 100%
      );
    }
  }
  .hero-inner {
    position: relative;
    z-index: 1;
    max-width: 62rem;
  }
  /* CSS-only entrance (H1 excluded: it is the LCP element and paints at once). */
  .hero-inner > :not(.hero-title) {
    animation: hero-in 0.7s var(--ease-signature) both;
  }
  .hero-inner > :nth-child(3) { animation-delay: 0.45s; }
  .hero-inner > :nth-child(4) { animation-delay: 0.6s; }
  .hero-inner > :nth-child(5) { animation-delay: 0.75s; }
  @keyframes hero-in {
    from { opacity: 0; transform: translateY(16px); }
  }
  .hero-title {
    font-size: var(--text-4xl);
    font-weight: 700;
    margin-top: 1.25rem;
    max-width: 15ch;
    text-shadow: 0 2px 30px rgba(0, 0, 0, 0.5);
  }
  /* Words never break mid-word; each one masks its rising characters. */
  .hero-word {
    display: inline-block;
    overflow: hidden;
    vertical-align: top;
    padding-bottom: 0.08em;
    margin-bottom: -0.08em;
    margin-right: 0.26em;
  }
  .hero-word:last-child {
    margin-right: 0;
  }
  .hero-word :global(.char) {
    display: inline-block;
    will-change: transform, opacity;
  }
  .hero-accent {
    color: var(--color-amber);
  }
  .hero-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 1.6s var(--ease-signature);
    pointer-events: none;
  }
  .hero-canvas:global(.is-live) {
    opacity: 1;
  }
  /* Slow push-in on load (wrapper, so GSAP can own the photo's own transform). */
  .hero-canvas-wrap {
    animation: hero-push 2.4s var(--ease-signature) both;
  }
  @keyframes hero-push {
    from { transform: scale(1.12); }
  }
  .hero-sub {
    font-size: var(--text-lg);
    color: var(--color-bone);
    margin-top: 1.5rem;
    max-width: 34ch;
    text-shadow: 0 1px 16px rgba(0, 0, 0, 0.7);
  }
  .hero-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    margin-top: 2rem;
  }
  .hero-stats {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(1.5rem, 5vw, 3.5rem);
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--line);
  }
  .hero-stat dt {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: 700;
    color: var(--fg);
  }
  .hero-stat dd {
    font-size: var(--text-xs);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--fg-dim);
    margin-top: 0.25rem;
  }
  .hero-scroll {
    position: absolute;
    bottom: 1.5rem;
    left: 50%;
    transform: translateX(-50%);
    width: 26px;
    height: 42px;
    border: 1.5px solid var(--line);
    border-radius: var(--radius-full);
    display: none;
    z-index: 1;
  }
  .hero-scroll span {
    position: absolute;
    top: 8px;
    left: 50%;
    width: 3px;
    height: 8px;
    border-radius: 2px;
    background: var(--color-amber);
    transform: translateX(-50%);
    animation: scrolldot 1.8s var(--ease-signature) infinite;
  }
  @keyframes scrolldot {
    0%, 100% { opacity: 0; transform: translate(-50%, 0); }
    40% { opacity: 1; }
    80% { opacity: 0; transform: translate(-50%, 14px); }
  }
  @media (min-width: 768px) {
    .hero-scroll {
      display: block;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-scroll span {
      animation: none;
    }
  }
</style>
