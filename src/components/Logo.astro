---
// Client brand logo (white-text version for the dark UI). Sources live in src/assets/brand/.
import { Image } from 'astro:assets';
import logo from '../assets/brand/logo-light-text.png';

interface Props {
  class?: string;
  /** Rendered height in px; width follows the logo's ~4.8:1 ratio. */
  height?: number;
}
const { class: cls = '', height = 40 } = Astro.props;
const width = Math.round((logo.width / logo.height) * height);
---

<Image
  src={logo}
  alt="Deluxe Move Broker"
  class={`logo ${cls}`}
  width={width}
  height={height}
  densities={[1, 2]}
  format="webp"
  loading="eager"
/>

<style>
  .logo {
    display: block;
    height: auto;
    max-width: 100%;
  }
</style>
