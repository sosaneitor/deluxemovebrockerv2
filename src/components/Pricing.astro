---
import { CONTENT, type Lang } from '../i18n/content';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = CONTENT[lang].pricing;
---

<section class="section pricing" id="pricing">
  <div class="shell">
    <header class="sec-head" data-reveal>
      <p class="eyebrow">{t.eyebrow}</p>
      <h2>{t.title}</h2>
      <p class="sec-sub">{t.sub}</p>
    </header>

    <div class="cmp-grid">
      {t.compare.map((c) => (
        <article class={`cmp-card ${c.tag ? 'cmp-card--premium' : ''}`} data-reveal data-spotlight>
          <div class="cmp-top">
            <h3>{c.name}</h3>
            {c.tag && <span class="cmp-tag">{c.tag}</span>}
          </div>
          <p class="cmp-best">{c.best}</p>
          <ul class="cmp-points">
            {c.points.map((p) => (
              <li>
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" aria-hidden="true">
                  <path d="M5 12.5l4.5 4.5L19 7.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                {p}
              </li>
            ))}
          </ul>
        </article>
      ))}
    </div>

    <h3 class="factors-title" data-reveal>{t.factorsTitle}</h3>
    <div class="price-grid">
      {t.factors.map((f, i) => (
        <article class="price-card" data-reveal data-spotlight>
          <span class="price-index">{String(i + 1).padStart(2, '0')}</span>
          <h4>{f.name}</h4>
          <p>{f.desc}</p>
        </article>
      ))}
    </div>

    <div class="price-foot" data-reveal>
      <p class="price-note"><span class="price-dot"></span>{t.note}</p>
      <a href="#quote" class="btn btn-amber">{CONTENT[lang].hero.cta}</a>
    </div>
  </div>
</section>

<style>
  .cmp-grid {
    display: grid;
    gap: 1.25rem;
    grid-template-columns: 1fr;
  }
  .cmp-card {
    padding: clamp(1.5rem, 3vw, 2.25rem);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--surface);
  }
  .cmp-card--premium {
    border-color: color-mix(in srgb, var(--color-amber) 55%, var(--line));
    background:
      radial-gradient(120% 80% at 100% 0%, color-mix(in srgb, var(--color-amber) 10%, transparent), transparent 60%),
      var(--surface);
  }
  .cmp-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .cmp-top h3 {
    font-size: var(--text-xl);
  }
  .cmp-tag {
    font-family: var(--font-display);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #0b0d10;
    background: var(--color-amber);
    padding: 0.3rem 0.65rem;
    border-radius: var(--radius-full);
  }
  .cmp-best {
    color: var(--fg-dim);
    margin-top: 0.5rem;
  }
  .cmp-points {
    list-style: none;
    padding: 0;
    margin-top: 1.25rem;
    display: grid;
    gap: 0.65rem;
  }
  .cmp-points li {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
  }
  .cmp-points svg {
    color: var(--color-amber);
    flex-shrink: 0;
    margin-top: 0.2rem;
  }
  .factors-title {
    font-size: var(--text-xl);
    margin-top: clamp(3rem, 6vw, 4.5rem);
    margin-bottom: 1.25rem;
  }
  .price-grid {
    display: grid;
    gap: 1.25rem;
    grid-template-columns: 1fr;
  }
  .price-card {
    position: relative;
    padding: clamp(1.5rem, 3vw, 2rem);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background: var(--surface);
    overflow: hidden;
  }
  .price-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 3px;
    height: 100%;
    background: linear-gradient(var(--color-amber), var(--color-amber-deep));
    transform: scaleY(0);
    transform-origin: top;
    transition: transform var(--dur-base) var(--ease-signature);
  }
  .price-card:hover::before {
    transform: scaleY(1);
  }
  .price-index {
    font-family: var(--font-display);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-amber);
  }
  .price-card h4 {
    font-size: var(--text-lg);
    margin-top: 0.5rem;
  }
  .price-card p {
    color: var(--fg-dim);
    margin-top: 0.6rem;
  }
  .price-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
    margin-top: 2rem;
  }
  .price-note {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-display);
    font-size: var(--text-base);
    color: var(--fg);
  }
  .price-dot {
    width: 8px;
    height: 8px;
    flex-shrink: 0;
    border-radius: 50%;
    background: var(--color-amber);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--color-amber) 22%, transparent);
  }
  @media (max-width: 559px) {
    .price-foot .btn {
      width: 100%;
    }
  }
  @media (min-width: 720px) {
    .cmp-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (min-width: 780px) {
    .price-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
