---
import { CONTENT, type Lang } from '../i18n/content';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = CONTENT[lang].pricing;
---

<section class="section pricing" id="pricing">
  <div class="shell">
    <header class="sec-head" data-reveal>
      <p class="eyebrow">{t.eyebrow}</p>
      <h2>{t.title}</h2>
      <p class="sec-sub">{t.sub}</p>
    </header>

    <div class="price-grid">
      {t.factors.map((f, i) => (
        <article class="price-card" data-reveal>
          <span class="price-index">{String(i + 1).padStart(2, '0')}</span>
          <h3>{f.name}</h3>
          <p>{f.desc}</p>
        </article>
      ))}
    </div>

    <p class="price-note" data-reveal>
      <span class="price-dot"></span>{t.note}
    </p>
  </div>
</section>

<style>
  .price-grid {
    display: grid;
    gap: 1.25rem;
    grid-template-columns: 1fr;
  }
  .price-card {
    position: relative;
    padding: clamp(1.5rem, 3vw, 2rem);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background: var(--surface);
    overflow: hidden;
  }
  .price-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 3px;
    height: 100%;
    background: linear-gradient(var(--color-amber), var(--color-amber-deep));
    transform: scaleY(0);
    transform-origin: top;
    transition: transform var(--dur-base) var(--ease-signature);
  }
  .price-card:hover::before {
    transform: scaleY(1);
  }
  .price-index {
    font-family: var(--font-display);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-amber);
  }
  .price-card h3 {
    font-size: var(--text-lg);
    margin-top: 0.5rem;
  }
  .price-card p {
    color: var(--fg-dim);
    margin-top: 0.6rem;
  }
  .price-note {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin-top: 2rem;
    font-family: var(--font-display);
    font-size: var(--text-base);
    color: var(--fg);
  }
  .price-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-amber);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--color-amber) 22%, transparent);
  }
  @media (min-width: 780px) {
    .price-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
