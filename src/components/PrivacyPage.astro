---
import Header from './Header.astro';
import Footer from './Footer.astro';
import { CONTENT, type Lang } from '../i18n/content';

interface Props { lang: Lang; currentYear: number }
const { lang, currentYear } = Astro.props;
const t = CONTENT[lang].privacy;
const home = lang === 'es' ? '/es/' : '/';
---

<Header lang={lang} altHref={lang === 'es' ? '/privacy/' : '/es/privacidad/'} />
<main id="main" class="legal">
  <div class="shell legal-inner">
    <a href={home} class="legal-back">← {t.back}</a>
    <h1>{t.title}</h1>
    <p class="legal-updated">Deluxe Move Broker LLC · {t.updated}</p>
    {t.sections.map((s) => (
      <section>
        <h2>{s.h}</h2>
        <p>{s.p}</p>
      </section>
    ))}
  </div>
</main>
<Footer lang={lang} currentYear={currentYear} />

<style>
  .legal {
    padding-top: clamp(7rem, 14vh, 9rem);
    padding-bottom: clamp(3rem, 8vw, 6rem);
  }
  .legal-inner {
    max-width: 46rem;
  }
  .legal-back {
    font-size: var(--text-sm);
    color: var(--fg-dim);
  }
  .legal-back:hover {
    color: var(--color-amber);
  }
  .legal h1 {
    font-size: var(--text-3xl);
    margin-top: 1rem;
  }
  .legal-updated {
    color: var(--fg-dim);
    margin-top: 0.75rem;
    font-size: var(--text-sm);
  }
  .legal section {
    margin-top: 2.25rem;
  }
  .legal h2 {
    font-size: var(--text-xl);
  }
  .legal section p {
    color: var(--fg-dim);
    margin-top: 0.75rem;
  }
</style>
