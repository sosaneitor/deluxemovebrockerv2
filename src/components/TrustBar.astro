---
import { CONTENT, type Lang } from '../i18n/content';
interface Props { lang: Lang }
const { lang } = Astro.props;
const items = CONTENT[lang].trust;
// Two copies so the loop is seamless; the second is hidden from assistive tech.
const groups = [false, true];
---

<div class="trust">
  <div class="trust-track">
    {groups.map((dup) => (
      <ul class="trust-list" aria-hidden={dup ? 'true' : undefined}>
        {[...items, ...items].map((label, i) => (
          <li class:list={{ dupe: i >= items.length }}>
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" aria-hidden="true">
              <path d="M12 3l7 3v5c0 4.5-3 7.7-7 9-4-1.3-7-4.5-7-9V6l7-3Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" />
              <path d="M9 12l2 2 4-4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            {label}
          </li>
        ))}
      </ul>
    ))}
  </div>
</div>

<style>
  .trust {
    position: relative;
    overflow: hidden;
    border-block: 1px solid var(--line);
    background: var(--surface);
    /* Fade the edges so items glide in and out. */
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
  }
  .trust-track {
    display: flex;
    width: max-content;
    animation: trust-scroll 40s linear infinite;
  }
  .trust:hover .trust-track {
    animation-play-state: paused;
  }
  .trust-list {
    list-style: none;
    display: flex;
    gap: 3rem;
    padding: 1.15rem 1.5rem;
    margin: 0;
  }
  .trust-list li {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    white-space: nowrap;
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 600;
  }
  .trust-list svg {
    color: var(--color-amber);
    flex-shrink: 0;
  }
  @keyframes trust-scroll {
    to { transform: translateX(-50%); }
  }
  /* Reduced motion: a static, wrapping list. */
  @media (prefers-reduced-motion: reduce) {
    .trust {
      -webkit-mask-image: none;
      mask-image: none;
    }
    .trust-track {
      width: auto;
      justify-content: center;
    }
    .trust-list {
      flex-wrap: wrap;
      justify-content: center;
    }
    .trust-list[aria-hidden='true'],
    .trust-list .dupe {
      display: none;
    }
  }
</style>
