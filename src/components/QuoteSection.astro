---
import QuoteForm from './QuoteForm.tsx';
import { CONTENT, CONTACT, whatsappHref, privacyHref, type Lang } from '../i18n/content';

interface Props { lang: Lang; currentYear: number }
const { lang, currentYear } = Astro.props;
const t = CONTENT[lang];
---

<section class="section quote" id="quote">
  <div class="shell quote-shell">
    <div class="quote-aside" data-reveal>
      <p class="eyebrow">{t.quote.eyebrow}</p>
      <h2>{t.quote.title}</h2>
      <p class="quote-lead">{t.quote.sub}</p>
      <ul class="quote-points">
        {t.quote.points.map((p) => (
          <li>
            <i aria-hidden="true">
              <svg viewBox="0 0 24 24" width="14" height="14" fill="none"><path d="M5 12.5l4.5 4.5L19 7.5" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" /></svg>
            </i>
            {p}
          </li>
        ))}
      </ul>
      <div class="quote-direct">
        <p class="quote-or">{t.quote.or}</p>
        <div class="quote-direct-row">
          <a href={CONTACT.phoneHref} class="quote-phone">{CONTACT.phone}</a>
          <a href={whatsappHref(lang)} target="_blank" rel="noopener" class="btn btn-ghost">
            {t.hero.ctaSecondary}
          </a>
        </div>
        <p class="quote-hours"><span>{t.quote.hoursLabel}:</span> {t.hours}</p>
      </div>
    </div>

    <div class="quote-form" data-reveal>
      {/* client:load so the form is interactive right away — with client:visible, text typed
          before hydration finished was wiped when React took over the server-rendered inputs. */}
      <QuoteForm lang={lang} currentYear={currentYear} privacyHref={privacyHref(lang)} client:load />
    </div>
  </div>
</section>

<style>
  .quote {
    background: var(--surface);
    border-top: 1px solid var(--line);
  }
  .quote-shell {
    display: grid;
    gap: clamp(2rem, 5vw, 3.5rem);
    align-items: start;
  }
  .quote-aside h2 {
    font-size: var(--text-3xl);
    margin-top: 0.75rem;
    max-width: 14ch;
  }
  .quote-lead {
    color: var(--fg-dim);
    font-size: var(--text-lg);
    margin-top: 1rem;
    max-width: 40ch;
  }
  .quote-points {
    list-style: none;
    padding: 0;
    margin-top: 1.75rem;
    display: grid;
    gap: 0.75rem;
  }
  .quote-points li {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-weight: 500;
  }
  .quote-points i {
    display: grid;
    place-items: center;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: color-mix(in srgb, var(--color-amber) 18%, transparent);
    color: var(--color-amber);
    flex-shrink: 0;
  }
  .quote-direct {
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }
  .quote-or {
    font-size: var(--text-sm);
    color: var(--fg-dim);
  }
  .quote-direct-row {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    margin-top: 0.75rem;
    flex-wrap: wrap;
  }
  .quote-phone {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--text-lg);
    color: var(--color-amber);
  }
  .quote-hours {
    margin-top: 0.85rem;
    font-size: var(--text-sm);
    color: var(--fg-dim);
  }
  .quote-hours span {
    color: var(--fg);
  }
  @media (min-width: 900px) {
    .quote-shell {
      grid-template-columns: 0.9fr 1.1fr;
    }
  }
</style>
